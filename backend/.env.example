# Go reads process environment variables; it does not automatically load this file.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://ayurflow:replace-with-a-local-password@localhost:5432/ayurflow?sslmode=disable

# Auth also enables reception-only patient routes. No policy defaults are assumed.
# Supply explicitly reviewed development settings; DEC07 review is required for release.
# AUTH_ENABLED=true
# AUTH_IDLE_TIMEOUT=<approved duration>
# AUTH_ABSOLUTE_TIMEOUT=<approved duration>
# AUTH_ATTEMPT_LIMIT=<approved integer>
# AUTH_ATTEMPT_WINDOW=<approved duration>
# AUTH_BLOCK_DURATION=<approved duration>
# AUTH_ALLOWED_ORIGIN=https://<approved same-origin host>
